# --- Site public -----------------------------------------------------------

# URL canonique du site en production, sans barre oblique finale.
# Elle alimente les balises canonical, Open Graph, le sitemap.xml et le robots.txt.
NEXT_PUBLIC_SITE_URL=https://exemple.com

# Code de validation Google Search Console (contenu de la balise
# <meta name="google-site-verification" content="..."> fournie par Google).
# Laisser vide tant que la propriété n'est pas créée.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Base de données -------------------------------------------------------

# Chaîne de connexion MongoDB, base incluse.
# Elle porte le contenu du CMS *et* les fichiers téléversés (GridFS, bucket
# « media » : collections media.files et media.chunks).
MONGODB_URI=

# --- Authentification du tableau de bord -----------------------------------

# Secret Better Auth. Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL de base de l'application, telle que vue par le navigateur.
BETTER_AUTH_URL=http://localhost:3000

# --- Création du premier administrateur ------------------------------------

# Utilisées uniquement par `pnpm bootstrap:admin`, jamais par l'application.
# La commande refuse d'écraser un compte existant.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# --- Envoi de courriel ------------------------------------------------------

# Clé API Resend. Sans elle, aucun courriel ne part : les confirmations de
# devis, les notifications de message et les infolettres échouent
# explicitement plutôt que d'être annoncées comme envoyées.
RESEND_API_KEY=

# Expéditeur transactionnel : confirmations, devis, notifications de message.
# Format « Nom <adresse@domaine> ». Le domaine doit être vérifié chez Resend.
MAIL_FROM=

# Expéditeur de l'infolettre. À défaut, MAIL_FROM est utilisé. Séparer les deux
# protège la délivrabilité des courriels essentiels d'un signalement pour
# pourriel sur une campagne.
MAIL_FROM_MARKETING=

# Adresse de réponse des courriels transactionnels. Facultatif.
MAIL_REPLY_TO=

# Adresse recevant les alertes d'exploitation : nouvelle demande de devis,
# décision du client, nouveau message. Sans elle, aucune alerte n'est tentée.
ADMIN_NOTIFICATION_EMAIL=

# --- Reprise des envois d'infolettre ----------------------------------------

# Secret partagé avec le planificateur qui appelle POST /api/newsletter/dispatch
# pour reprendre une campagne interrompue. Générer avec : openssl rand -hex 32
# Sans ce secret, seule une session d'administration peut relancer un envoi.
CRON_SECRET=
