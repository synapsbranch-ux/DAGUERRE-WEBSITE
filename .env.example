# --- Site public -----------------------------------------------------------

# URL canonique du site en production, sans barre oblique finale.
# Elle alimente les balises canonical, Open Graph, le sitemap.xml et le robots.txt.
NEXT_PUBLIC_SITE_URL=https://exemple.com

# Code de validation Google Search Console (contenu de la balise
# <meta name="google-site-verification" content="..."> fournie par Google).
# Laisser vide tant que la propriété n'est pas créée.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Base de données -------------------------------------------------------

# Chaîne de connexion MongoDB, base incluse.
# Elle porte le contenu du CMS *et* les fichiers téléversés (GridFS, bucket
# « media » : collections media.files et media.chunks).
MONGODB_URI=

# --- Identité : Logto -------------------------------------------------------

# Logto est le fournisseur d'identité. Ce dépôt ne stocke aucun mot de passe,
# n'émet aucune session et ne détient aucun rôle : il vérifie le jeton signé
# qu'il reçoit, et refuse ce qui n'est pas autorisé.

# URL de l'instance Logto, sans barre oblique finale.
LOGTO_ENDPOINT=https://auth.exemple.com

# Application « traditionnelle » créée dans la console Logto.
# URI de rappel à y enregistrer : <NEXT_PUBLIC_SITE_URL>/api/auth/callback
# URI de déconnexion : <NEXT_PUBLIC_SITE_URL>/fr
LOGTO_APP_ID=
LOGTO_APP_SECRET=

# Chiffre le cookie de session. Générer avec : openssl rand -base64 32
LOGTO_COOKIE_SECRET=

# Nom exact du rôle Logto qui ouvre le tableau de bord. Deux rôles utilisateur
# sont à créer dans la console : « admin » et « customer ».
LOGTO_ADMIN_ROLE=admin

# Clé de signature du webhook Logto (console → Webhooks). Le point d'entrée
# /api/webhooks/logto refuse toute requête non signée : sans elle, n'importe qui
# pourrait faire apparaître, renommer ou suspendre un compte dans le miroir.
# Événements à cocher : User.Created, User.Data.Updated, User.Deleted,
# User.SuspensionStatus.Updated.
LOGTO_WEBHOOK_SIGNING_KEY=

# --- Management API de Logto ------------------------------------------------

# Application « machine à machine » distincte, avec l'accès à la Management API.
# Elle sert à lister les comptes et à changer un rôle depuis le tableau de bord.
# Sans elle, ces deux fonctions répondent 503 plutôt que de simuler un succès.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# Indicateur de ressource de la Management API. Sur une instance auto-hébergée,
# le locataire s'appelle « default » et la valeur ci-dessous convient telle
# quelle — ce n'est pas une URL à joindre, c'est un identifiant.
LOGTO_MANAGEMENT_RESOURCE=https://default.logto.app/api

# --- Signature des capacités applicatives -----------------------------------

# Signe les liens de confirmation d'infolettre, de désabonnement et de
# rattachement de devis. Aucun rapport avec l'authentification.
# Générer avec : openssl rand -base64 32
#
# ATTENTION : les liens de désabonnement n'expirent jamais et vivent dans des
# courriels déjà envoyés. Changer cette valeur les casse tous, en silence.
# Sur une installation qui portait BETTER_AUTH_SECRET, reprendre la même valeur.
APP_TOKEN_SECRET=

# --- Envoi de courriel ------------------------------------------------------

# Clé API Resend. Sans elle, aucun courriel ne part : les confirmations de
# devis, les notifications de message et les infolettres échouent
# explicitement plutôt que d'être annoncées comme envoyées.
RESEND_API_KEY=

# Expéditeur transactionnel : confirmations, devis, notifications de message.
# Format « Nom <adresse@domaine> ». Le domaine doit être vérifié chez Resend.
MAIL_FROM=

# Expéditeur de l'infolettre. À défaut, MAIL_FROM est utilisé. Séparer les deux
# protège la délivrabilité des courriels essentiels d'un signalement pour
# pourriel sur une campagne.
MAIL_FROM_MARKETING=

# Adresse de réponse des courriels transactionnels. Facultatif.
MAIL_REPLY_TO=

# Adresse recevant les alertes d'exploitation : nouvelle demande de devis,
# décision du client, nouveau message. Sans elle, aucune alerte n'est tentée.
ADMIN_NOTIFICATION_EMAIL=

# --- Tâches planifiées ------------------------------------------------------

# Secret partagé avec le planificateur qui appelle /api/cron toutes les cinq
# minutes : reprise des envois interrompus, départ des campagnes programmées,
# péremption des propositions. Générer avec : openssl rand -hex 32
#
# Sans ce secret, la voie automatique est fermée et ces trois tâches ne
# tournent jamais : les campagnes programmées ne partent pas, et les
# propositions n'expirent pas.
#
# Voir vercel.json et .github/workflows/cron.yml. Pour tout autre
# planificateur :
#   curl -H "authorization: Bearer $CRON_SECRET" https://exemple.com/api/cron
CRON_SECRET=

# Secret de signature des notifications Resend (webhook), commençant par
# « whsec_ ». Il rend les statistiques d'envoi réelles : distribué, rejeté,
# plainte. Sans lui, le point d'entrée /api/webhooks/resend refuse tout —
# un webhook ouvert permettrait à quiconque de faire cesser les envois vers
# une adresse de son choix.
RESEND_WEBHOOK_SECRET=

# --- Limitation de débit ----------------------------------------------------

# Magasin partagé de la limitation de débit des formulaires publics.
# Sans lui, le comptage est local au processus : avec plusieurs instances, la
# limite réelle est multipliée par leur nombre, et il suffit de répartir ses
# requêtes pour l'annuler. Obligatoire dès qu'il y a plus d'une instance.
REDIS_URL=

# Variante HTTPS, pour un hébergement où une socket TCP n'est pas tenable.
# Renseigner l'une ou l'autre, pas les deux.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
